-D tjson=1.4.0
-cp C:/HaxeToolkit/haxe/lib/linc_luajit/0,0,2
-D linc_luajit=0.0.2
-cp C:/HaxeToolkit/haxe/lib/hscript-iris/1,1,3
-D hscript-iris=1.1.3
-cp C:/HaxeToolkit/haxe/lib/hxdiscord_rpc/1,2,4
-D hxdiscord_rpc=1.2.4
