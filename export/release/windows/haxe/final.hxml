-D hxcpp=4.3.2
-cp C:/HaxeToolkit/haxe/lib/flxanimate/4,0,0
-D flxanimate=4.0.0
-cp C:/HaxeToolkit/haxe/lib/flixel-ui/2,5,0
-D flixel-ui=2.5.0
-cp source
-D CRASH_HANDLER
-D LUA_ALLOWED
-D PSYCH_WATERMARKS
-D MULTITHREADED_LOADING
-D lime-openalsoft
-D lime-harfbuzz
-D lime-threads
-D hscriptPos
-D tools=8.3.0
-D FLX_NO_DEBUG
-D HXCPP_CHECK_POINTER
-D HXCPP_STACK_TRACE
-D no-compilation
-D NAPE_RELEASE_BUILD
-D HXCPP_STACK_LINE
-D HSCRIPT_ALLOWED
-D lime-native
-D lime-vorbis
-D lime-cffi
-D SHOW_LOADING_SCREEN
-D lime-openal
-D message.reporting=pretty
-D DISCORD_ALLOWED
-D native
-D lime-curl
-D openfl-native
-D MODS_ALLOWED
-D FLX_NO_FOCUS_LOST_SCREEN
-D lime-cairo
-D lime-threads-deque
-D no-deprecation-warnings
-D ACHIEVEMENTS_ALLOWED
-D lime-opengl
